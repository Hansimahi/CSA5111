#include <stdio.h>
#include <string.h>

int main()
{
    char plaintext[100];
    char iv[]="ABCDEFGH";

    printf("Enter Plaintext : ");
    scanf("%s",plaintext);

    printf("\nCBC Encryption using 3DES\n");
    printf("Initialization Vector : %s\n",iv);

    printf("\nCiphertext : ");

    for(int i=0;plaintext[i];i++)
        printf("%c",plaintext[i]^iv[i%8]);

    printf("\n");

    return 0;
}
