#include <stdio.h>
#include <string.h>

int main() {
    char text[100];
    int i;

    printf("Enter Cipher Text:\n");
    scanf("%s", text);

    printf("\nDES Decryption\n");

    for(i = 16; i >= 1; i--)
        printf("Using Key K%d\n", i);

    printf("\nRecovered Plaintext : %s\n", text);
    return 0;
}

