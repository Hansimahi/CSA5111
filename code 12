#include <stdio.h>
#include <string.h>

int modInverse(int a)
{
    a%=26;
    for(int x=1;x<26;x++)
        if((a*x)%26==1)
            return x;
    return -1;
}

int main()
{
    char text[100];
    int key[2][2]={{9,4},{5,7}};

    printf("Enter Plain Text (uppercase, even letters): ");
    scanf("%s",text);

    printf("\nCipher Text : ");

    for(int i=0;text[i];i+=2)
    {
        int p1=text[i]-'A';
        int p2=text[i+1]-'A';

        int c1=(key[0][0]*p1+key[0][1]*p2)%26;
        int c2=(key[1][0]*p1+key[1][1]*p2)%26;

        printf("%c%c",c1+'A',c2+'A');
    }

    return 0;
}
