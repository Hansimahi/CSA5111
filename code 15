#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char cipher[500];

    printf("Enter Cipher Text : ");
    scanf("%[^\n]",cipher);

    for(int key=0;key<26;key++)
    {
        printf("\nKey %2d : ",key);

        for(int i=0;cipher[i];i++)
        {
            if(isupper(cipher[i]))
                printf("%c",((cipher[i]-'A'-key+26)%26)+'A');

            else if(islower(cipher[i]))
                printf("%c",((cipher[i]-'a'-key+26)%26)+'a');

            else
                printf("%c",cipher[i]);
        }
    }

    return 0;
}
